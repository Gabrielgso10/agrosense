# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Dados e artefatos grandes (o .tflite e os fontes gerados do firmware SÃO versionados)
data/*
!data/.gitkeep
# Lote original de fotos do TCC, importado do Drive
!data/originais/
data/originais/*
!data/originais/*/
models/saved_model/
models/*.npz
models/model.keras

# ESP-IDF (sdkconfig é gerado a partir do sdkconfig.defaults; dependencies.lock deve ser versionado)
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old

# Arquivos temporários do Word (aparecem enquanto o .docx está aberto)
~$*

# Banco de dados do painel (telemetria e fotos de cada instalação)
painel/*.db
